+<section id="faq-acne" style="border-top: 1px solid #e2dccd; scroll-margin-top: 80px">
+<div class="faq" style="max-width: 1240px; margin: 0 auto; padding: 56px 24px; display: flex; flex-direction: column; gap: 24px">
